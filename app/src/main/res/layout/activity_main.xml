<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="16dp">

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/mtv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp"
        android:text="@string/title_books"
        android:textSize="20sp" android:textStyle="bold" android:textColor="?attr/colorPrimary"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/mcv_edt"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardCornerRadius="8dp"
        app:cardElevation="1dp"
        app:layout_constraintTop_toBottomOf="@id/mtv_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="6dp"
            android:orientation="vertical">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_book_code"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_book_code" app:startIconDrawable="@drawable/ic_book_code">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/tie_book_code"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_book_name"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_book_name" app:startIconDrawable="@drawable/ic_book">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/tie_book_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapSentences"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_publication_date"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_publication_date"
                app:startIconDrawable="@android:drawable/ic_menu_day">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/tie_publication_date"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:focusable="false"
                    android:clickable="true"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:id="@+id/lo_btn"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="8dp" android:layout_marginBottom="8dp"
        app:layout_constraintTop_toBottomOf="@id/mcv_edt"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/mbtn_add"
            style="@style/Widget.Material3.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginHorizontal="3dp" android:textSize="12sp" app:cornerRadius="8dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:text="@string/add" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/mbtn_read"
            style="@style/Widget.Material3.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginHorizontal="3dp" android:textSize="12sp" app:cornerRadius="8dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:text="@string/read" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/mbtn_delete"
            style="@style/Widget.Material3.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginHorizontal="3dp" android:textSize="12sp" app:cornerRadius="8dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:text="@string/delete" app:backgroundTint="?attr/colorError" android:textColor="?attr/colorOnError" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/mbtn_share"
            style="@style/Widget.Material3.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginHorizontal="3dp" android:textSize="12sp" app:cornerRadius="8dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:text="@string/share" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rcv_books"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/lo_btn"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
